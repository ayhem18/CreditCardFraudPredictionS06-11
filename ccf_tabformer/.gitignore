# dl_toolbox project tree: track code + configs, ignore payloads and envs.
storage/
# token export (large .npy; copied in, not committed)
data/tokens/
# OOF/submission outputs (copied back to the competition repo for blending)
outputs/
.venv/
*venv
*.egg-info/
__pycache__/
*.py[oc]
.pytest_cache/
# mlflow / tensorboard local stores (also land under storage/, kept for safety)
mlruns/
*.sqlite
# dl-toolbox: never commit remote-store credentials
project_level_configs/remote/credentials/
