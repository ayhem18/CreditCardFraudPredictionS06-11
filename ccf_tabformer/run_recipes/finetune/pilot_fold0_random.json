{
  "human_readable_name": "mfm_finetune_pilot_fold0_random",
  "run_group": [
    "finetune",
    "pilot"
  ],
  "seed": 0,
  "trainer": {
    "max_epochs": 15,
    "accelerator": "gpu",
    "devices": 1,
    "precision": "bf16-mixed",
    "enable_progress_bar": true,
    "accumulate_grad_batches": 1
  },
  "checkpoint_policy": {
    "save_top_k": 0,
    "save_last": true
  },
  "early_stopping": {
    "name": "none"
  },
  "logger": {
    "experiment": "ccf_tabformer_finetune",
    "tags": {
      "task": "finetune",
      "scope": "pilot_fold0",
      "regime": "random"
    }
  },
  "experiment_config": {
    "data": {
      "inner_table": "fixed_width_v1",
      "folds": "alarm_profile_5fold_v1",
      "fold": 0,
      "batch_size": 1024,
      "num_workers": 4
    },
    "regime": "random",
    "pretrained_checkpoint": "",
    "embedding": {
      "strategy": "additive",
      "args": {
        "d_model": 1024
      }
    },
    "encoder": {
      "strategy": "prenorm_transformer",
      "args": {
        "d_model": 1024,
        "n_layers": 6,
        "n_heads": 8,
        "ffn_mult": 4,
        "dropout": 0.0
      }
    },
    "classifier_head": {
      "strategy": "mean_pool",
      "args": {
        "d_model": 1024,
        "hidden": 256,
        "dropout": 0.1
      }
    },
    "lr_config": {
      "learning_rate": 0.0001
    },
    "optimizer_config": {
      "name": "adamw",
      "weight_decay": 0.0,
      "betas": [0.9, 0.95]
    },
    "lr_scheduler_config": {
      "name": "constant"
    }
  }
}
