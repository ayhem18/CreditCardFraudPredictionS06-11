{
  "human_readable_name": "ft_smoke_local",
  "run_group": ["finetune", "smoke"],
  "seed": 0,
  "trainer": {
    "max_epochs": 2,
    "accelerator": "gpu",
    "devices": 1,
    "precision": "bf16-mixed",
    "enable_progress_bar": true,
    "accumulate_grad_batches": 1
  },
  "checkpoint_policy": {
    "save_top_k": 1,
    "save_last": false
  },
  "early_stopping": {
    "name": "none"
  },
  "logger": {
    "experiment": "ccf_tabformer_finetune",
    "tags": {
      "scope": "smoke",
      "task": "finetune"
    }
  },
  "experiment_config": {
    "tokens_dir": "data/tokens",
    "fold": 0,
    "init": "pretrained",
    "freeze_encoder": false,
    "pretrained_checkpoint": "storage/run_artifacts/pretrain/smoke/mfm_smoke_local/checkpoints/live/8c99f9e21729.ckpt",
    "model": {
      "d_model": 128,
      "n_layers": 2,
      "n_heads": 4,
      "ffn_mult": 4,
      "dropout": 0.1
    },
    "head": {
      "hidden": 64,
      "dropout": 0.1
    },
    "data": {
      "batch_size": 512,
      "num_workers": 0,
      "max_rows": 40000
    },
    "optimizer": {
      "learning_rate": 0.0003,
      "weight_decay": 0.01,
      "encoder_lr_mult": 0.3
    }
  }
}
