{
  "human_readable_name": "mfm_v1_d768_l12",
  "run_group": ["pretrain", "v1"],
  "seed": 0,
  "trainer": {
    "max_epochs": 30,
    "accelerator": "gpu",
    "devices": 2,
    "precision": "bf16-mixed",
    "enable_progress_bar": false,
    "accumulate_grad_batches": 1
  },
  "checkpoint_policy": {
    "save_top_k": 1,
    "save_last": true
  },
  "early_stopping": {
    "name": "none"
  },
  "logger": {
    "experiment": "ccf_tabformer_pretrain",
    "tags": {
      "scope": "full",
      "task": "mfm_pretrain",
      "model": "d768_l12"
    }
  },
  "experiment_config": {
    "tokens_dir": "data/tokens",
    "corpus": "all",
    "model": {
      "d_model": 768,
      "n_layers": 12,
      "n_heads": 12,
      "ffn_mult": 4,
      "dropout": 0.1
    },
    "data": {
      "batch_size": 2048,
      "num_workers": 8,
      "max_rows": 0
    },
    "mask": {
      "token_mask_prob": 0.12,
      "feature_mask_prob": 0.10
    },
    "optimizer": {
      "learning_rate": 0.0006,
      "weight_decay": 0.01
    }
  }
}
